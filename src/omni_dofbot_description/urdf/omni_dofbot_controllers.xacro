<?xml version="1.0" encoding="UTF-8" ?>
<robot name="omni_dofbot_controllers" xmlns:xacro="http://ros.org/wiki/xacro">

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <!--
        Requiere gz_ros2_control compilado desde fuente (jazzy branch).
        Source order: /opt/ros/jazzy → ~/gz_fix_ws/install → tu workspace.
      -->
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ══════════════ BASE OMNIDIRECCIONAL ══════════════ -->
    <joint name="front_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="back_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="back_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- ══════════════ BRAZO DOFBOT ══════════════ -->
    <joint name="arm_joint_01">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_joint_02">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_joint_03">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_joint_04">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_joint_05">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- ══════════════ GRIPPER ══════════════ -->
    <!--
      grip_joint es la junta activa (revolute).
      Las juntas mimic (rfinger_joint_01/02, lfinger_grip_joint_01/02/03)
      NO tienen command_interface porque gz_ros2_control no soporta
      mimic constraints — el movimiento lo replica Gazebo visualmente
      pero el comando solo va a grip_joint.
    -->
    <joint name="grip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rfinger_joint_01">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rfinger_joint_02">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lfinger_grip_joint_01">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lfinger_grip_joint_02">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lfinger_grip_joint_03">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find omni_dofbot_description)/config/omni_dofbot_controller.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
