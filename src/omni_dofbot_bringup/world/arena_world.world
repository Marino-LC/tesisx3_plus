<?xml version="1.0" ?>
<!--
  arena_world.world — v2
  Cambios: O1 y O2 centradas en x=0
  O1: (0.00, +0.25)  O2: (0.00, -0.30)
-->
<sdf version="1.7">
  <world name="arena_world">

    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.4</sor>
        </solver>
      </ode>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>
    <light name="ambient_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- Suelo melamina mu=0.4 -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.22 2.42 0.02</size></box></geometry>
          <pose>0 0 -0.01 0 0 0</pose>
          <surface>
            <friction>
              <ode>
                <mu>0.4</mu><mu2>0.4</mu2>
                <fdir1>1 0 0</fdir1>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp><kd>100</kd>
                <min_depth>0.001</min_depth>
                <max_vel>1.0</max_vel>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.22 2.42 0.02</size></box></geometry>
          <pose>0 0 -0.01 0 0 0</pose>
          <material>
            <ambient>0.92 0.87 0.78 1</ambient>
            <diffuse>0.92 0.87 0.78 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Paredes perimetrales -->
    <model name="wall_north">
      <static>true</static><pose>0 1.215 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.22 0.03 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.22 0.03 0.30</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -1.215 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.22 0.03 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.22 0.03 0.30</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>0.615 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.03 2.42 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.03 2.42 0.30</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-0.615 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.03 2.42 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.03 2.42 0.30</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.7 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstáculo 1 — centro x=0, y=+0.25 -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>0.00 0.25 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.35</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.35</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstáculo 2 — centro x=0, y=-0.30 -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>0.00 -0.30 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.35</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.35</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pedestal 15×15×20cm en y=+0.81 -->
    <model name="pedestal">
      <static>true</static>
      <pose>0.0 0.81 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.20</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.20</size></box></geometry>
          <material><ambient>0.3 0.3 0.8 1</ambient><diffuse>0.3 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cubo objetivo 2.5×2.5×2.5cm sobre el pedestal -->
    <model name="target_cube">
      <static>false</static>
      <pose>0.0 0.81 0.2125 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.050</mass>
          <inertia>
            <ixx>5.2e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>5.2e-6</iyy><iyz>0</iyz><izz>5.2e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
            <contact><ode><kp>1e5</kp><kd>10</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Marcadores visuales de waypoints -->
    <model name="wp1"><static>true</static><pose>0.00 -0.91 0.02 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0 0.4 1 0.6</ambient><diffuse>0 0.4 1 0.6</diffuse></material></visual></link></model>

    <model name="wp2"><static>true</static><pose>-0.38 -0.42 0.02 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.5 0 1 0.6</ambient><diffuse>0.5 0 1 0.6</diffuse></material></visual></link></model>

    <model name="wp3"><static>true</static><pose>0.38 -0.18 0.02 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.5 0 1 0.6</ambient><diffuse>0.5 0 1 0.6</diffuse></material></visual></link></model>

    <model name="wp4"><static>true</static><pose>-0.38 0.13 0.02 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.5 0 1 0.6</ambient><diffuse>0.5 0 1 0.6</diffuse></material></visual></link></model>

    <model name="wp5"><static>true</static><pose>0.38 0.38 0.02 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.5 0 1 0.6</ambient><diffuse>0.5 0 1 0.6</diffuse></material></visual></link></model>

    <model name="wp6"><static>true</static><pose>0.00 0.71 0.02 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0 0.8 0.2 0.7</ambient><diffuse>0 0.8 0.2 0.7</diffuse></material></visual></link></model>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -3.5 4.5 0 0.75 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
