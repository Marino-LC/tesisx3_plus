<?xml version="1.0"?>
<!--
    Rueda mecanum de 9 rodillos (modelo propio).
    Origen: EnsambleRuedaDerecha.urdf / EnsambleRuedaIzquierda.urdf (CAD, STL en mm -> scale 0.001).

    Cada macro crea:
      ${prefix}_wheel            plato 1 (el que gira con la junta ${prefix}_joint, eje Z)
      ${prefix}_plate_2          plato 2 (fijo al plato 1)
      ${prefix}_roller_1..9      rodillos libres (juntas continuas pasivas)

    Los nombres ${prefix}_wheel y ${prefix}_joint son los mismos que usaba la rueda anterior,
    por lo que controladores, ros2_control y nodos de cinematica no cambian.

    OJO: "derecha"/"izquierda" son las dos QUIRALIDADES de la rueda, no el lado del robot.
    En configuracion X, FL y BR llevan la misma, y FR y BL la otra.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="mecanum_mesh_dir" value="file://$(find omni_description)/meshes/X3"/>

    <!-- Quiralidad DERECHA (DERECHA.stl) -->
    <xacro:macro name="mecanum_wheel_derecha" params="prefix parent xyz rpy">

        <link name="${prefix}_wheel">
            <inertial>
                <origin xyz="-2.6213984065263684e-15 -6.944101739142697e-17 -0.008670638697794967" rpy="0.0 -0.0 0.0"/>
                <mass value="0.19277691549739548"/>
                <inertia ixx="3.917018233893549e-05" ixy="2.2311041902867496e-18" ixz="1.1724355802718083e-18"
                         iyy="3.917018233815902e-05" iyz="-1.3206389364025225e-19" izz="6.710310113924815e-05"/>
            </inertial>
            <visual>
                <origin xyz="0.0 0.0 -0.018536" rpy="-1.9721522630525295e-31 -2.3353329992581426e-61 -1.1841545112969503e-30"/>
                <geometry>
                    <mesh filename="${mecanum_mesh_dir}/DERECHA.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="0.7 0.7 0.7 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 -0.018536" rpy="-1.9721522630525295e-31 -2.3353329992581426e-61 -1.1841545112969503e-30"/>
                <geometry>
                    <mesh filename="${mecanum_mesh_dir}/DERECHA.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <parent link="${parent}"/>
            <child link="${prefix}_wheel"/>
            <axis xyz="0 0 1"/>
            <limit effort="100" velocity="25.0"/>
        </joint>

        <link name="${prefix}_plate_2">
            <inertial>
                <origin xyz="-2.621398406526372e-15 -6.94410173914267e-17 0.009865361302205012" rpy="0.0 0.0 0.0"/>
                <mass value="0.19277691549739548"/>
                <inertia ixx="3.9170182338935664e-05" ixy="2.2158381900172485e-18" ixz="1.1724355802718102e-18"
                         iyy="3.9170182338159036e-05" iyz="-1.3206389364024915e-19" izz="6.710310113924793e-05"/>
            </inertial>
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <mesh filename="${mecanum_mesh_dir}/DERECHA.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="0.7 0.7 0.7 1"/>
