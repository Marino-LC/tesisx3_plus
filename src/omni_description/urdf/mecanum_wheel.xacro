    <!-- Quiralidad IZQUIERDA (IZQUIERDA.stl) -->
    <xacro:macro name="mecanum_wheel_izquierda" params="prefix parent xyz rpy">

        <link name="${prefix}_wheel">
            <inertial>
                <origin xyz="-2.621400133639507e-15 -5.7867552618973665e-18 -0.008670633227399954" rpy="0.0 -0.0 0.0"/>
                <mass value="0.19277678848605548"/>
                <inertia ixx="3.917010169678587e-05" ixy="4.4622083805737217e-20" ixz="1.1724328158344976e-18"
                         iyy="3.9170101696009665e-05" iyz="-2.2160851523965214e-20" izz="6.710295818528929e-05"/>
            </inertial>
            <visual>
                <origin xyz="0.0 0.0 -0.018536" rpy="0.0 -0.0 0.0"/>
                <geometry>
                    <mesh filename="${mecanum_mesh_dir}/IZQUIERDA.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="0.7 0.7 0.7 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 -0.018536" rpy="0.0 -0.0 0.0"/>
                <geometry>
                    <mesh filename="${mecanum_mesh_dir}/IZQUIERDA.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <parent link="${parent}"/>
            <child link="${prefix}_wheel"/>
            <axis xyz="0 0 1"/>
            <limit effort="100" velocity="25.0"/>
        </joint>

        <link name="${prefix}_plate_2">
            <inertial>
                <origin xyz="-2.621400133639508e-15 -5.786755261897515e-18 0.009865366772600083" rpy="0.0 0.0 0.0"/>
