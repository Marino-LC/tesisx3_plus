                <geometry>
                    <mesh filename="${mecanum_mesh_dir}/DERECHA.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_plate_2_joint" type="fixed">
            <origin xyz="-7.888609052210118e-33 0.0 0.01850000000000001" rpy="3.141592653589793 -1.538931129906045e-15 0.7853981633974486"/>
