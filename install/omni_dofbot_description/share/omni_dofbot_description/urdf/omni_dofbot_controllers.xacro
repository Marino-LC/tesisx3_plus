          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
      </joint>
      <joint name="rfinger_joint_02">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
      </joint>
      <joint name="lfinger_grip_joint_01">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
      </joint>
      <joint name="lfinger_grip_joint_02">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
