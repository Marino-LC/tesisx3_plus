      <!-- ================= BASE OMNIDIRECCIONAL ================= -->
      <joint name="front_left_joint"> <!-- M1 -->
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="front_right_joint"> <!-- M2 -->
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="back_right_joint"> <!-- M3 -->
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="back_left_joint"> <!-- M4 -->
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
  </ros2_control>

<!-- ÚNICO PLUGIN NECESARIO PARA COMUNICAR GAZEBO CON ROS 2 -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"> <!-- ¡AQUÍ TAMBIÉN! -->
      <parameters>$(find omni_dofbot_description)/config/omni_dofbot_controller.yaml</parameters>
    </plugin>
  </gazebo>
  
</robot>